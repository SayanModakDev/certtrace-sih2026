# CertTrace Sepolia Environment Configuration

# Trusted Sepolia contract allowlist. Never populate these from a proof or URL.
NEXT_PUBLIC_V1_CONTRACT_ADDRESS=0x0F89d0a4311a3EEbB6C04F664A590DB73006Ceca
NEXT_PUBLIC_V2_CONTRACT_ADDRESS=

# New certificates are issued against this version. Set v2 only after V2 is deployed and verified.
NEXT_PUBLIC_ISSUANCE_CONTRACT_VERSION=v1

# Backwards-compatible legacy variables; optional when the explicit variables above are set.
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_CONTRACT_VERSION=v1

# Canonical public Vercel origin used in generated QR links (for example, https://certtrace.example).
# When omitted in the browser, CertTrace uses the current window origin.
NEXT_PUBLIC_APP_ORIGIN=

# Public Sepolia RPC URL (optional, defaults to https://ethereum-sepolia-rpc.publicnode.com)
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
